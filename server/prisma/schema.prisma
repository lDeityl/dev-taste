generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "darwin", "debian-openssl-1.1.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Users {
    id                               Int      @id @default(autoincrement())
    createdAt                        DateTime @default(now())
    email                            String   @unique
    name                             String
    role                             Roles    @default(USER)
    isEmailActivated                 Boolean  @default(false)
    password                         String
    phone                            String?
    imgURL                           String?
    code_change_password             Int?
    code_confirmation_email          String?
    twoFactorAuthenticationSecret    String?
    isTwoFactorAuthenticationEnabled Boolean?
}

model Companies {
    id        Int       @id @default(autoincrement())
    createdAt DateTime  @default(now())
    name      String
    imageUrl  String
    Product   Product[]
    isActive  Boolean
}

model Product {
    id            Int         @id @default(autoincrement())
    createdAt     DateTime    @default(now())
    imageUrl      String
    name          String
    description   String
    price         Int
    squirrels     Int
    fats          Int
    carbohydrates Int
    calories      Int
    weight        Int
    Category      Companies   @relation(fields: [categoryId], references: [id])
    categoryId    Int
    isActive      Boolean     @default(true)
    ProductType   ProductType @relation(fields: [productTypeId], references: [id])
    productTypeId Int
}

model ProductType {
    id      Int       @id @default(autoincrement())
    name    String
    Product Product[]
}

model Stock {
    id          Int      @id @default(autoincrement())
    createdAt   DateTime @default(now())
    imageUrl    String
    title       String
    description String
    date        String
}

model Faq {
    id          Int      @id @default(autoincrement())
    createdAt   DateTime @default(now())
    title       String
    description String
}

model MainSettings {
    id                 Int      @id @default(autoincrement())
    createdAt          DateTime @default(now())
    contactsPhone      String
    delivery_schedule  String
    cafe_opening_hours String
    address            String
    email              String
    about_title        String
    about_description  String
}

enum Roles {
    USER
    ADMIN
}
